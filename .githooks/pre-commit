#!/bin/sh
# Enabled per clone: git config core.hooksPath .githooks (see CLAUDE.md).
# Skips when no Rust file or rustfmt.toml is staged.
git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.rs$|rustfmt\.toml$' || exit 0
cargo fmt --all --check >/dev/null 2>&1 || { echo "pre-commit: run 'cargo fmt --all'" >&2; exit 1; }
# WebKit doesn't build on Windows, Servo takes about 33 minutes, and CEF's build needs its download; lint the rest.
cargo lint -q -j 8 -- -D warnings || { echo "pre-commit: clippy failed" >&2; exit 1; }
