#!/bin/sh
# Enabled per clone: git config core.hooksPath .githooks (see CLAUDE.md).
# Skips when no Rust file or rustfmt.toml is staged.
git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.rs$|rustfmt\.toml$' || exit 0
cargo fmt --all --check >/dev/null 2>&1 || { echo "pre-commit: run 'cargo fmt --all'" >&2; exit 1; }
# WebKit and Servo don't build on Windows, and CEF's build needs its download; lint what does.
cargo clippy -q -j 8 -p manifold -p manifold-view-protocol -p manifold-view-webview2 -p manifold-view-pdfium -p gate --all-targets -- -D warnings || { echo "pre-commit: clippy failed" >&2; exit 1; }
